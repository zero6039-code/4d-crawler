{
  "outputDirectory": "docs",
  "cleanUrls": false,
  "redirects": [
    { "source": "/my4d.apk", "destination": "/app-release.apk", "permanent": false }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
